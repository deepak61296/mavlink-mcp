<mxfile host="app.diagrams.net">
  <diagram id="arch" name="mavlink-mcp architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="mavlink-mcp — natural-language flight control for AI agents" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>

        <!-- COLUMN 1: clients -->
        <mxCell id="cl" value="AI AGENT CLIENTS&#10;(interchangeable — MCP is the seam)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="230" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="cl1" value="Claude Code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="125" width="190" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cl2" value="Codex CLI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="163" width="190" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cl3" value="opencode + local model (Ollama)&#10;→ fully OFFLINE missions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="201" width="190" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="cl4" value="INTENT DETECTION lives here:&#10;the LLM maps the operator&#39;s English&#10;onto the tool schemas the server&#10;published. Server defines the intent&#10;inventory; model does the mapping;&#10;server validates the result." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="255" width="190" height="110" as="geometry"/>
        </mxCell>

        <!-- COLUMN 2: server -->
        <mxCell id="sv" value="mavlink-mcp SERVER (Python, ~4.5k lines, 118 unit + 42 SITL tests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="640" height="820" as="geometry"/>
        </mxCell>

        <mxCell id="l1" value="MCP SURFACE — server.py&#10;19 tools. Bounds live in the schema (Altitude &gt; 0, ≤ 120 m; Distance ≤ 500 m; Direction = 12 words).&#10;Annotations: read-only → client auto-approves | destructive → client prompts a HUMAN.&#10;Resources: mavlink://vehicle, mavlink://telemetry. Flight tools NOT REGISTERED unless --enable-actuation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="115" width="600" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="l2" value="GUARD PIPELINE — runs in fixed order on EVERY flight call&#10;1. lazy connect (first use, double-checked lock)&#10;2. actuation gate: --enable-actuation set? vehicle streams SIMSTATE (proof it is SITL — a loopback address proves nothing)? PX4 → refused. non-copter → refused.&#10;3. reject(): nonsense args (negative altitude, NaN, lat 91) refused BEFORE anything arms&#10;4. actuation lock (non-blocking): second command fails fast, never queues" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="225" width="600" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="l3" value="FLIGHT VERBS — flight.py (runs in a WORKER THREAD, so telemetry + e-stop still answer)&#10;takeoff / land / rtl / goto / move / orbit / set_altitude / wait&#10;Send command → then POLL TELEMETRY every 0.4 s until the aircraft actually arrives.&#10;(MAVLink ACK = &quot;instruction received&quot;, never &quot;done&quot;.) Every poll loop watches the interrupt flag." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="355" width="600" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="l4" value="SAFETY — safety.py (three tiers, three different questions)&#10;reject: nonsense at any setting → refuse | clamp_noted: past a limit → trim AND announce, naming the right rule&#10;param_block: FENCE_*, FS_*, ARMING_*, BATT_FS, BRD_SAFETY refused at ANY value (bitmask/radius bypass shapes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="600" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="l5" value="BACKEND CONTRACT — interfaces.py (the seam)&#10;RobotBackend: 8 generic methods. No takeoff() method — verbs travel as DATA through execute_primitive().&#10;Telemetry = neutral snapshot (metres/degrees; unknown = None, never 0). Adding PX4 = one new class." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="565" width="600" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="l6" value="MAVLINK BACKEND — backends/ardupilot.py (the ONLY file that speaks MAVLink)&#10;ONE owner thread owns the socket (mavutil is not thread-safe) — everyone else posts to a queue + waits on a Future.&#10;Decodes stream → Telemetry. Sends COMMAND_LONG, waits COMMAND_ACK. 3 Hz GCS heartbeat (even inside ACK waits,&#10;or the FC&#39;s own GCS failsafe fires). Timed-out commands are CANCELLED so they can never fire late." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="660" width="600" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="l7" value="fake.py — in-memory drone, no ports (tests/demos)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="770" width="290" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="l8" value="camera.py — Gazebo/RTSP frames → capture_camera (JPEG)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="770" width="290" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="es" value="EMERGENCY STOP: never takes the lock → sets interrupt flag (unwinds the running verb) → RTL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="815" width="600" height="35" as="geometry"/>
        </mxCell>

        <!-- COLUMN 3: vehicle -->
        <mxCell id="vh" value="ARDUPILOT VEHICLE / SITL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1090" y="80" width="290" height="330 " as="geometry"/>
        </mxCell>
        <mxCell id="vh1" value="GUIDED mode; COMMAND_LONG + ACK;&#10;SET_POSITION_TARGET (NO ack — only&#10;telemetry confirms a goto)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1105" y="120" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="vh2" value="SIMSTATE: streamed ONLY by SITL —&#10;the vehicle proves it is a simulator;&#10;config never gets to claim it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1105" y="200" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="vh3" value="FC&#39;s OWN fence + failsafes stay armed&#10;underneath everything — the layer&#10;param_block refuses to weaken" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1105" y="280" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="cam" value="Gazebo world / RTSP camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="440" width="290" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="rp" value="EVERY REPLY = result + [state: alt X m, MODE, armed] read from LIVE telemetry.&#10;The model reports what the aircraft DID, never what it was asked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="1090" y="530" width="290" height="90" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="MCP over stdio (JSON-RPC): tool schemas down, tool calls up" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="cl" target="l1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="MAVLink (tcp / udp / serial)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="l6" target="vh">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="video stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="cam" target="l8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
