<mxfile host="app.diagrams.net">
  <diagram id="arch" name="mavlink-mcp architecture">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="mavlink-mcp — from natural-language instruction to confirmed flight" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="1100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;AI agent  (any MCP client)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Claude Code&lt;br&gt;Codex CLI&lt;br&gt;opencode with a local model (Ollama)&lt;br&gt;&lt;br&gt;The model maps the operator's instruction onto the tool schemas published by the server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="250" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="approve" value="&lt;b&gt;Operator confirmation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flight tools carry the destructive annotation, so the client requests operator approval before each flight action. Read-only tools are approved automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="250" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="srv" value="&lt;b&gt;mavlink-mcp server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#888888;verticalAlign=top;fontSize=15;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="880" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="serverpy" value="&lt;b&gt;server.py  —  tool registration, schemas, guards&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read-only, always registered:  get_status · describe_vehicle · check_armable · get_param · capture_camera&lt;br&gt;Flight, registered only with --enable-actuation:  arm · disarm · takeoff · land · rtl · goto · move · orbit ·&lt;br&gt;set_altitude · wait · set_mode · set_param · point_camera · emergency_stop&lt;br&gt;&lt;br&gt;Argument bounds are declared in the schema (altitude ≤ 120 m, distance ≤ 500 m), so out-of-range requests&lt;br&gt;are rejected before reaching application code. Guards execute in fixed order: connect → actuation gate&lt;br&gt;(SIMSTATE confirms a simulator; PX4 refused) → argument rejection → single-command lock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="145" width="820" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="flightpy" value="&lt;b&gt;flight.py  —  flight verb implementation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Implements each verb end to end: arm → set GUIDED → issue command → poll telemetry at 0.4 s intervals until the vehicle has physically arrived.&lt;br&gt;&lt;br&gt;A COMMAND_ACK confirms receipt only, not completion. Each poll loop checks the interrupt flag used by emergency stop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="400" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="safetypy" value="&lt;b&gt;safety.py  —  refusal and clamping&lt;/b&gt;&lt;br&gt;&lt;br&gt;reject — arguments invalid at any setting: negative altitude, latitude 91, NaN&lt;br&gt;&lt;br&gt;clamp and report — values past a limit are trimmed, and the governing rule is named&lt;br&gt;&lt;br&gt;param_block — FENCE_* , FS_* and ARMING_* refused at any value: raising FENCE_RADIUS weakens a fence as much as disabling it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="330" width="400" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="ifacepy" value="&lt;b&gt;interfaces.py  —  backend contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;RobotBackend: eight generic methods. Verbs are passed as data through execute_primitive(), so PX4 support is a single additional backend class." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="525" width="820" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="apbackend" value="&lt;b&gt;backends/ardupilot.py  —  MAVLink transport (pymavlink)&lt;/b&gt;&lt;br&gt;&lt;br&gt;A single owner thread holds the connection, as pymavlink is not thread-safe; all other callers post a request and block on the result.&lt;br&gt;&lt;br&gt;Transmits:  COMMAND_LONG — NAV_TAKEOFF, COMPONENT_ARM_DISARM, DO_SET_MODE, each awaiting COMMAND_ACK&lt;br&gt;                    SET_POSITION_TARGET_GLOBAL_INT — goto and move, unacknowledged&lt;br&gt;Receives:   HEARTBEAT · GLOBAL_POSITION_INT · VFR_HUD · SYS_STATUS · EKF_STATUS_REPORT · SIMSTATE,&lt;br&gt;                    decoded into one Telemetry snapshot&lt;br&gt;Maintains: a 3 Hz GCS heartbeat, required by the flight controller's own GCS failsafe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="610" width="540" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="fakepy" value="&lt;b&gt;backends/fake.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;In-memory vehicle requiring no ports. Implements the same contract; used by the test suite." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="920" y="610" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="campy" value="&lt;b&gt;camera.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decodes UDP/H.264 or RTSP via OpenCV; capture_camera returns a JPEG frame to the client." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="920" y="740" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="estop" value="&lt;b&gt;emergency_stop&lt;/b&gt;&lt;br&gt;&lt;br&gt;Does not queue behind the running command: sets the interrupt flag, unwinding the active verb mid-poll, then commands RTL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="870" width="820" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;Result returned to the model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every reply carries a state line read from live telemetry at that moment — [state: alt 20.0 m, GUIDED, armed] — so the model reports the vehicle's actual state rather than the requested one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="110" width="360" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="ardupilot" value="&lt;b&gt;ArduPilot  (SITL or vehicle)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reached over TCP, UDP or serial.&lt;br&gt;&lt;br&gt;Operates in GUIDED while under external command.&lt;br&gt;&lt;br&gt;SIMSTATE is transmitted only by the simulator, and is the evidence the actuation gate requires.&lt;br&gt;&lt;br&gt;The flight controller's own geofence and failsafes remain active beneath this entire stack." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="410" width="360" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="video" value="&lt;b&gt;Video source&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gazebo simulation over UDP/H.264, or an RTSP payload camera on a real airframe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="740" width="360" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="MCP over stdio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=2;endArrow=block;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="240" as="sourcePoint"/>
            <mxPoint x="360" y="240" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="MAVLink" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=2;endArrow=block;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="550" as="sourcePoint"/>
            <mxPoint x="1260" y="550" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="video" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=2;endArrow=block;strokeColor=#444444;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="790" as="sourcePoint"/>
            <mxPoint x="1180" y="790" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
